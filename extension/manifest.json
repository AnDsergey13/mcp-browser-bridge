{
  "manifest_version": 2,
  "name": "Kimi Code Bridge",
  "version": "0.1.0",
  "description": "Мост между bridge-server (контейнер) и браузером: выполнение команд страницы по политике, выдаваемой сервером.",
  "permissions": ["tabs", "notifications", "storage", "webRequest"],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/injector.js", "src/background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@localhost",
      "strict_min_version": "109.0"
    }
  }
}
