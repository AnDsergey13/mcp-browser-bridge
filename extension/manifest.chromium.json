{
  "manifest_version": 3,
  "name": "Kimi Code Bridge",
  "version": "0.1.0",
  "description": "Мост между bridge-server (контейнер) и браузером: выполнение команд страницы по политике, выдаваемой сервером.",
  "permissions": ["tabs", "notifications", "storage", "webRequest", "scripting", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw-loader.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Bridge"
  }
}
